---
import { DEFAULT_LANGUAGE, dict } from "@/i18n";
import PatternBg from "@/ui/PatternBg.astro";
import { removeSpaces } from "@/utils";
import p from "@constants/personal";
import { Icon } from "astro-icon/components";

const about = dict[DEFAULT_LANGUAGE].components?.aboutMe;
const text = about?.text ?? "";
const aboutWord = about?.about ?? "Sobre";
const meWord = about?.me ?? "mim";

const aboutMeClass = removeSpaces(
  `font-cascadia-code relative flex h-fit min-h-screen w-full flex-col items-center justify-center gap-8 px-6 
    py-24 text-white sm:px-10`,
);

const spanClass = removeSpaces(
  `text-gray-default hover:text-gray-default rounded bg-white/80 p-0.5 transition-colors duration-300 
    ease-in-out hover:bg-transparent dark:hover:text-white/80`,
);

const chipClass = removeSpaces(
  `inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3 py-1 
    text-xs font-semibold text-white/80 sm:text-sm`,
);
---

<section id="about-me" class={aboutMeClass}>
  <div
    aria-hidden="true"
    class="absolute inset-0 overflow-hidden pointer-events-none mask-[linear-gradient(to_bottom,transparent,black_20%,black_80%,transparent)]"
  >
    <PatternBg />
    <span class="hidden md:block top-10/12 -right-8 absolute font-black text-[22rem] text-white/30 dark:text-white/10 leading-none -translate-y-1/2 select-none">
      &lt;/&gt;
    </span>
  </div>

  <div class="z-10 relative flex flex-col items-center gap-8 w-full max-w-4xl">
    <div class="flex flex-col items-center gap-3">
      <h2
        id="about"
        class="font-bold text-gray-default dark:text-white/80 text-4xl"
      >
        <span data-i18n="components.aboutMe.about">{aboutWord}</span>
        {"\u2009"}
        <span id="me" class={spanClass} data-i18n="components.aboutMe.me">
          {meWord}
        </span>
      </h2>
    </div>

    <div class="relative flex flex-col gap-6 bg-gray-default p-5 sm:p-6 rounded-md">
      <p class="max-w-none text-white text-lg sm:text-xl text-pretty leading-relaxed">
        <span data-i18n="components.aboutMe.text">{text}</span>
      </p>

      <ul class="flex flex-wrap justify-center gap-2">
        <li class={chipClass}>
          <Icon
            name="material-symbols:location-on-rounded"
            class="size-4"
            aria-hidden="true"
          />
          {p.location}, {p.country}
        </li>
        <li class={chipClass}>
          <Icon
            name="material-symbols:code-rounded"
            class="size-4"
            aria-hidden="true"
          />
          {p.position}
        </li>
      </ul>
    </div>
  </div>
</section>
