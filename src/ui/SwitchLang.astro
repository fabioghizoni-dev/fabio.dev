---
import { dict, languages } from "@/i18n";
import { Icon } from "astro-icon/components";
import cn from "../utils";

interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  id?: string;
  class?: string;
  iconClass?: string;
  type?: astroHTML.JSX.ButtonHTMLAttributes["type"];
  title?: string;
  translate?: astroHTML.JSX.ButtonHTMLAttributes["translate"];
  "aria-label"?: astroHTML.JSX.ButtonHTMLAttributes["aria-label"];
  /** Keeps the switcher visible outside the desktop header (e.g. modals). */
  inline?: boolean;
}

const {
  iconClass = "",
  id = "btn-lang",
  type = "button",
  translate = "no",
  class: className = "",
  title = "Mudar idioma",
  "aria-label": ariaLabel = title,
  inline = false,
  ...rest
}: Props = Astro.props;

const btnBaseClass = cn(
  "relative flex min-w-8 min-h-8 size-8 p-0.5 text-1xl font-cascadia-code font-bold cursor-pointer items-center justify-center",
);
const btnFinalClass = cn(btnBaseClass, className);
const listId = `${id}-list`;

const iconFinalClass = cn(
  "size-full text-white hover:text-purple-blue transition-colors duration-200 ease-in-out",
  iconClass,
);
---

<div
  data-language-switcher
  class={inline ? "relative" : "relative max-md:order-1"}
>
  <button
    type={type}
    translate={translate}
    id={id}
    title={title}
    aria-label={ariaLabel}
    data-i18n-attr="title:components.header.changeLanguage|aria-label:components.header.changeLanguage"
    data-lang-button
    aria-expanded="false"
    aria-controls={listId}
    class={btnFinalClass}
    {...rest}
  >
    <Icon
      name="material-symbols:translate"
      class={iconFinalClass}
      aria-hidden="true"
    />
  </button>
  <ul
    id={listId}
    data-lang-list
    class={cn(
      `invisible top-full left-1/2 z-50 absolute flex flex-col gap-1 bg-gray-default opacity-0 shadow-black/20 shadow-xl mt-3 p-1 border border-white/35 rounded-lg max-h-0 overflow-y-auto font-inter font-normal text-base transition-all -translate-x-1/2 duration-200 ease-in-out`,
    )}
  >
    {languages.map((lang) => {
      const languageName = dict[lang]?.name ?? lang;
      return (
        <li class="text-white">
          <button
            type="button"
            lang={lang}
            data-language={lang}
            title={languageName}
            aria-label={languageName}
            class="hover:bg-purple-blue/30 px-3 py-1.5 rounded-md w-full text-left text-nowrap transition-colors cursor-pointer"
          >
            {lang}
          </button>
        </li>
      );
    })}
  </ul>
</div>

<script src="../scripts/switch-lang.ts"></script>
