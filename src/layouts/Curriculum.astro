---
import Layout from "@/layouts/Layout.astro";
import Education from "@/ui/curriculum/Education.astro";
import Experience from "@/ui/curriculum/Experience.astro";
import Header from "@/ui/curriculum/Header.astro";
import Skills from "@/ui/curriculum/Skills.astro";
import { removeSpaces } from "@/utils";
import p from "@constants/personal";

interface Props {
  online?: boolean;
}

const { online = false }: Props = Astro.props;
const theme = Astro.url.searchParams.get("theme") || "dark";

export const titleClass = removeSpaces(
  `border-b-2 border-black/40 bg-linear-to-br from-blue-500 to-cyan-400 bg-clip-text text-3xl font-bold text-transparent uppercase dark:border-white/40`,
);

const description = `Page Curriculum | Resume page containing all professional and academic information of ${p.name}`;
---

<Layout
  dataTheme={theme}
  title=`Curriculum | ${p.name}`
  description={description}
  bodyClass={`*:w-full *:max-w-8xl bg-white justify-start dark:bg-gray-default dark:text-white gap-8 px-20 py-4 ${online ? "font-space-grotesk" : "font-inter"}`}
>
  <Header online={online} />
  <Experience />
  <Education />
  <Skills />
</Layout>
