---
import { DEFAULT_LANGUAGE, dict } from "@/i18n";
import { Icon } from "astro-icon/components";
import HeroBadge from "./HeroBadge.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props as Props;

const components = dict[DEFAULT_LANGUAGE].components;
const role = components?.hero?.badge ?? "Full-Stack Developer";
---

<div class:list={["relative h-full w-full", className]}>
  <div class="relative flex flex-col justify-center items-center lg:items-start gap-4 lg:gap-8 h-full lg:text-left text-center">
    <div class="relative">
      <h1 class="flex flex-col items-center lg:items-start gap-2">
        <span
          data-i18n="components.hero.greeting"
          class="font-cascadia-code font-bold text-gray-default lg:text-[10px] dark:text-white/65 text-xs uppercase tracking-[0.35em]"
        >
          Olá, eu sou
        </span>{" "}
        <span class="inline-flex flex-col bg-clip-text bg-linear-to-br from-white to-white/35 font-black text-transparent text-6xl leading-[0.92] tracking-tight">
          <span>Fábio</span> <span>Ghizoni</span>
        </span>
      </h1>
    </div>

    <div class="relative flex justify-center lg:justify-start items-center gap-3">
      <span class="place-items-center grid bg-gray-default border border-white/35 rounded-full size-10 shrink-0">
        <Icon
          name="material-symbols:code-rounded"
          aria-hidden="true"
          class="size-4.5 text-purple-default"
        />
      </span>
      <div class="min-w-0">
        <p
          class="font-space-grotesk font-bold text-gray-default dark:text-white/80 lg:text-base text-lg"
          data-i18n="components.hero.badge"
        >
          {role}
        </p>
        <p
          class="mt-0.5 font-cascadia-code font-semibold text-[0.75rem] text-gray-default dark:text-white/80"
        >
          Astro ᝰ React ᝰ TypeScript ᝰ Node.js
        </p>
      </div>
    </div>

    <div class="relative">
      <HeroBadge class="justify-center lg:justify-start" />
    </div>
  </div>
</div>
