---
import { dict, languages } from "@/i18n";
import { Icon } from "astro-icon/components";
import cn from "../utils";

interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  id?: string;
  class?: string;
  iconClass?: string;
  type?: astroHTML.JSX.ButtonHTMLAttributes["type"];
  role?: astroHTML.JSX.ButtonHTMLAttributes["role"];
  title?: astroHTML.JSX.ButtonHTMLAttributes["title"];
  translate?: astroHTML.JSX.ButtonHTMLAttributes["translate"];
  "aria-label"?: astroHTML.JSX.ButtonHTMLAttributes["aria-label"];
}

const {
  iconClass = "",
  id = "btn-lang",
  role = "button",
  type = "button",
  translate = "no",
  class: className = "",
  title = "Change language",
  "aria-label": ariaLabel = title,
  ...rest
}: Props = Astro.props;

const btnBaseClass =
  "relative hidden md:flex min-w-8 min-h-8 size-8 p-0.5 text-1xl font-cascadia-code font-bold cursor-pointer items-center justify-center";
const btnFinalClass = cn(btnBaseClass, className);

const iconFinalClass = cn(
  "size-full text-white hover:text-purple-blue transition-colors duration-200 ease-in-out",
  iconClass,
);
---

<div class="hidden md:block relative">
  <button
    type={type}
    role={role}
    translate={translate}
    id={id}
    title={title}
    aria-label={ariaLabel}
    data-i18n-attr="title:components.header.changeLanguage|aria-label:components.header.changeLanguage"
    aria-expanded="false"
    aria-controls="list-langs"
    class={btnFinalClass}
    {...rest}
  >
    <Icon name="material-symbols:translate" class={iconFinalClass} />
  </button>
  <ul
    role="list"
    id="list-langs"
    class={cn(
      `invisible top-full left-1/2 z-50 absolute flex flex-col gap-1 bg-gray-default opacity-0 shadow-black/20 shadow-xl mt-3 p-1 border border-white/35 rounded-lg max-h-0 overflow-hidden font-noto-sans-jp font-normal text-base transition-all -translate-x-1/2 duration-200 ease-in-out`,
    )}
  >
    {
      languages.map((lang) => {
        return (
          <li role="listitem" title={dict[lang].name} class="text-white">
            <button
              type="button"
              data-language={lang}
              class="hover:bg-purple-blue/30 px-3 py-1.5 rounded-md w-full text-left text-nowrap transition-colors cursor-pointer"
            >{lang}</button>
          </li>
        );
      })
    }
  </ul>
</div>

<script src="../scripts/switch-lang.ts"></script>
