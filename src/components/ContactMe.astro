---
import Modal from "@/ui/Modal.astro";
import SocialButton from "@/ui/SocialButton.astro";
import cn from "@/utils";
import { dict } from "@/i18n";
import p from "@constants/personal";
import { actions } from "astro:actions";

let showModal = false;
const actionResult = Astro.getActionResult(actions.send);
if (actionResult?.data?.success) showModal = true;
const contactText = dict["pt-BR"].components.contactMeActive;
---

<section
  id="contact-me"
  class={cn(
    "flex flex-col justify-center items-center gap-8 bg-light px-8 py-12 w-full min-h-screen font-cascadia-code",
  )}
>
  {
    showModal && (
      <Modal
        btnLabel="Ok"
        switchLang={false}
        id="modal-success-email"
        title={contactText.successTitle}
        message={contactText.successMessage}
        titleKey="components.contactMeActive.successTitle"
        messageKey="components.contactMeActive.successMessage"
        btnLabelKey="components.contactMeActive.ok"
      />
    )
  }
  <h1 class="font-medium dark:text-white text-3xl md:text-4xl text-center">
    <span data-i18n="components.contactMeActive.title">{contactText.title}</span>
  </h1>
  <h2 class="max-w-5xl dark:text-white text-lg md:text-2xl text-center">
    <span data-i18n="components.contactMeActive.subtitle">{contactText.subtitle}</span>
  </h2>
  <div
    class="flex flex-wrap md:*:flex-none *:flex-1 justify-center items-center gap-4 md:gap-8 w-full"
  >
    <SocialButton><span data-i18n="components.contactMeActive.social.whatsapp">{contactText.social.whatsapp}</span></SocialButton>
    <SocialButton
      name="line-md:instagram"
      title={p.socials.insta}
      href={p.socials.insta}
    >
      <span data-i18n="components.contactMeActive.social.instagram">{contactText.social.instagram}</span>
    </SocialButton>
    <SocialButton
      name="line-md:github"
      title={p.socials.github}
      href={p.socials.github}><span data-i18n="components.contactMeActive.social.github">{contactText.social.github}</span></SocialButton
    >
    <SocialButton
      name="line-md:linkedin"
      title={p.socials.linkedin}
      href={p.socials.linkedin}><span data-i18n="components.contactMeActive.social.linkedin">{contactText.social.linkedin}</span></SocialButton
    >
  </div>
  <form
    method="post"
    id="contact-form"
    name="contact-form"
    class="flex flex-col gap-4 w-full max-w-2xl text-gray-default dark:text-white text-base md:text-2xl"
  >
    <input type="hidden" name="language" value="pt-BR" data-language-input />
    <div class="flex flex-col gap-2">
      <label for="name" class="font-medium text-base md:text-2xl"
        ><span data-i18n="components.contactMeActive.form.name">{contactText.form.name}</span></label
      >
      <input
        required
        id="name"
        name="name"
        type="text"
        minlength="2"
        maxlength="100"
        autocomplete="name"
        placeholder="Seu nome aqui"
        data-i18n-attr="placeholder:components.contactMeActive.form.namePlaceholder"
        class="bg-black px-3 md:px-4 py-2 border-2 border-white/30 focus:border-white/70 rounded-lg focus:outline-none text-white placeholder:text-white/50 transition"
      />
    </div>
    <div class="flex flex-col gap-2">
      <label for="email" class="font-medium text-base md:text-2xl"
        ><span data-i18n="components.contactMeActive.form.email">{contactText.form.email}</span></label
      >
      <input
        required
        id="email"
        type="email"
        name="email"
        maxlength="255"
        autocomplete="email"
        placeholder="seu.email@exemplo.com"
        data-i18n-attr="placeholder:components.contactMeActive.form.emailPlaceholder"
        class="bg-black px-3 md:px-4 py-2 border-2 border-white/30 focus:border-white/70 rounded-lg focus:outline-none text-white placeholder:text-white/50 transition"
      />
    </div>
    <div class="flex flex-col gap-2">
      <label for="message" class="font-medium text-base md:text-2xl"
        ><span data-i18n="components.contactMeActive.form.message">{contactText.form.message}</span></label
      >
      <textarea
        required
        rows="6"
        id="message"
        name="message"
        minlength="10"
        maxlength="2000"
        placeholder="Escreva sua mensagem aqui..."
        data-i18n-attr="placeholder:components.contactMeActive.form.messagePlaceholder"
        class="bg-black px-3 md:px-4 py-2 border-2 border-white/30 focus:border-white/70 rounded-lg focus:outline-none text-white placeholder:text-white/50 transition resize-none"
      ></textarea>
    </div>
    <button
      id="submit"
      type="submit"
      class={cn(
        `flex justify-center items-center gap-4 bg-linear-to-r from-purple-default to-purple-blue disabled:opacity-50 mt-4 px-6 py-3 rounded-lg text-white hover:text-white/70 text-base md:text-xl transition cursor-pointer disabled:cursor-not-allowed`,
      )}
    >
      <span data-i18n="components.contactMeActive.form.submit">{contactText.form.submit}</span>
    </button>
  </form>
</section>

<script src="../scripts/contact-me.ts"></script>
