---
import cn from "@/utils";
import { Icon } from "astro-icon/components";
import UnderlineButton from "../UnderlineButton.astro";

const ulClass = cn(
  `hidden fixed overflow-hidden md:sticky md:flex flex-col md:flex-row p-6 md:p-0 justify-center items-center text-xl ml-auto font-bold 
    text-white font-cascadia-code space-y-4 md:space-y-0 md:gap-8`,
);
---

<>
  <button
    id="menu"
    role="button"
    class="group relative flex h-6 w-8 cursor-pointer flex-col items-center justify-between p-0.5 md:hidden"
  >
    <div
      class="from-purple-default to-purple-blue h-0.9 min-h-0.9 w-9/12 self-end rounded-full bg-linear-to-r transition-[width] duration-300 ease-in-out group-hover:w-full"
    >
    </div>
    <div
      class="from-purple-default to-purple-blue h-0.9 min-h-0.9 w-full self-end rounded-full bg-linear-to-r transition-[width] duration-300 ease-in-out group-hover:w-9/12"
    >
    </div>
    <div
      class="from-purple-default to-purple-blue h-0.9 min-h-0.9 w-full rounded-full bg-linear-to-r"
    >
    </div>
  </button>

  <ul id="list-menu" class={ulClass}>
    <Icon
      data-menu-close
      title="Close modal"
      aria-label="Close modal"
      name="line-md:menu-to-close-transition"
      class={cn(`hover:text-purple-blue size-6 cursor-pointer text-gray-500 transition-colors duration-200 ease-in-out 
        md:hidden dark:hover:text-gray-300`)}
    />
    <li><UnderlineButton data-menu-link data-i18n="components.header.home">Início</UnderlineButton></li>
    <li>
      <UnderlineButton id="li-about-me" title="Ir para a seção Sobre" data-i18n-attr="title:components.header.about" data-menu-link>
        <span data-i18n="components.header.about">Sobre</span>
      </UnderlineButton>
    </li>
    <li>
      <UnderlineButton id="li-contact-me" title="Ir para a seção Contato" data-i18n-attr="title:components.header.contact" data-menu-link>
        <span data-i18n="components.header.contact">Contato</span>
      </UnderlineButton>
    </li>
  </ul>
</>

<script src="../../scripts/menu.ts"></script>
