---
import CopyRight from "@/components/layout/CopyRight.astro";
import Header from "@/components/layout/Header.astro";
import "@/styles/globals.css";
import Modal from "@/ui/Modal.astro";
import cn, { googleFontsUrl, removeSpaces } from "@/utils";
import p from "@constants/personal";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  lang?: string;
  title?: string;
  author?: string;
  modal?: boolean;
  header?: boolean;
  footer?: boolean;
  siteUrl?: string;
  iconHref?: string;
  dataTheme?: string;
  generator?: string;
  bodyClass?: string;
  keywords?: string[];
  description?: string;
  clientRouter?: boolean;
  /** Skips the stored/system theme override (e.g. print or query-driven themes). */
  lockTheme?: boolean;
}

const {
  description: rawDescription,
  header,
  footer,
  lang = "pt-BR",
  modal = true,
  bodyClass = "",
  dataTheme = "dark",
  clientRouter = true,
  lockTheme = false,
  iconHref = "/logo.svg",
  author = p.name,
  generator = Astro.generator,
  title = `Portfólio | ${p.name}`,
  siteUrl = p.siteUrl,
  keywords = [
    "Astro",
    "React",
    "Node.js",
    "Database",
    "Back-end",
    "Front-end",
    "Portfolio",
    "Developer",
    "TypeScript",
    "JavaScript",
    "UI/UX Design",
    "Tailwind CSS",
    "Web Developer",
    "Fábio Ghizoni",
    "Paraná Brazil",
    "Tech Portfolio",
    "Web Development",
    "API development",
    "Software Engineer",
    "Desenvolvedor Web",
    "Responsive Design",
    "Full-stack Developer",
    "Programador Full-stack",
    "Web Application Development",
  ],
}: Props = Astro.props;

const description = removeSpaces(
  rawDescription ??
    `Welcome to my portfolio website. Feel free to explore and learn more about the site and me. Here you'll find 
      my projects and information about my skills and experiences.`,
);

const canonical = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = `${siteUrl}/logo_neon.png`;
const locale = lang.replace("-", "_");

const baseBodyClass = removeSpaces(
  `dark:selection:text-purple-blue selection:bg-purple-blue flex min-h-screen w-full flex-col items-center justify-between 
    bg-white/80 transition-colors duration-500 ease-in-out selection:text-white dark:bg-black dark:selection:bg-white`,
);
---

<!doctype html>
<html lang={lang} data-theme={dataTheme}>
  <head>
    {!lockTheme && <script is:inline>
      try {
        const stored = localStorage.getItem("site:theme");
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>}

    {clientRouter && <ClientRouter />}

    <meta name="google-site-verification" content="EpMhc15ZfKlbTiR3npnKkCzJ6HKggIC9dbzX6acD3DI" />

    <meta charset="UTF-8" />
    <meta name="language" content={lang} />
    <meta name="author" content={author} />
    <meta name="generator" content={generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={dataTheme === "dark" ? "#000" : "#fff"} />
    <meta name="keywords" content={keywords.join(", ")} />

    <!-- Title -->
    <title>{title}</title>

    <!-- Icon -->
    <link rel="icon" type="image/svg+xml" href={iconHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`Logo de ${p.name}`} />

    <!-- Twitter Card -->
    <meta name="twitter:title" content={title} />
    <meta name="twitter:creator" content={p.socials.x} />
    <meta name="twitter:site" content={p.socials.x} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href={googleFontsUrl("googleapis")} />
    <link crossorigin rel="preconnect" href={googleFontsUrl("gstatic")} />
    <link
      rel="stylesheet"
      href={`${googleFontsUrl("googleapis")}/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap`}
    />
    <link
      rel="stylesheet"
      href={`${googleFontsUrl("googleapis")}/css2?family=Cascadia+Code:ital,wght@0,200..700;1,200..700&family=Space+Grotesk:wght@300..700&display=swap`}
    />
  </head>
  <body class={cn(baseBodyClass, bodyClass)}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:top-4 focus:left-4 focus:z-100 focus:fixed focus:bg-purple-blue focus:shadow-lg focus:px-4 focus:py-2 focus:rounded-lg focus:text-white"
    >
      <span data-i18n="ui.skipToContent">Pular para o conteúdo</span>
    </a>

    <Analytics />
    <SpeedInsights />

    {header && <Header />}
    {modal && <Modal />}
    <main id="main" class="contents">
      <slot />
    </main>
    {footer && <CopyRight />}

    <script>
      import { defaultLogger as logger } from "clogs.ts";

      addEventListener("DOMContentLoaded", () => {
        try {
          const lang =
            localStorage.getItem("site:lang") ||
            document.documentElement.lang ||
            "pt-BR";
          document.documentElement.lang = lang;
          logger.Log(`🌐 Language initialized: ${lang}`);
        } catch (err) {
          logger.Warn("Error initializing language:", err);
        }
      });
    </script>
    <script src="../scripts/i18n.ts"></script>
  </body>
</html>
