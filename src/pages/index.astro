---
export const prerender = false;
import AboutMe from "@/components/sections/AboutMe.astro";
import ContactMe from "@/components/sections/ContactMe.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import Projects from "@/components/sections/Projects.astro";
import Layout from "@/layouts/Layout.astro";
import GradientBg from "@/ui/GradientBg.astro";
import ScrollToTop from "@/ui/ScrollToTop.astro";
import Technologies from "@/ui/Technologies.astro";
import p from "@constants/personal";
---

<Layout header footer title=`Web | ${p.name}`>
  <div class="relative w-full">
    <GradientBg />
    <HeroSection />
    <AboutMe />
  </div>
  <Technologies />
  <Projects />
  <ContactMe />
  <ScrollToTop />
</Layout>
