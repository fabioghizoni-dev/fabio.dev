---
import { Icon } from "astro-icon/components";
import { dict, DEFAULT_LANGUAGE } from "@/i18n";
import cn from "../utils";

const label =
  dict[DEFAULT_LANGUAGE].components?.header?.changeTheme ?? "Mudar tema";

const finalClass =
  cn(`relative hidden md:flex min-w-8 min-h-8 w-8 h-8 p-0.5 ml-auto justify-center items-center 
    text-white cursor-pointer rounded-md hover:text-purple-blue overflow-hidden transition-all ease-in-out 
      duration-300`);
---

<button
  type="button"
  id="btn-theme"
  aria-label={label}
  aria-pressed="true"
  data-i18n-attr="aria-label:components.header.changeTheme|title:components.header.changeTheme"
  title={label}
  class={finalClass}
>
  <Icon
    id="moon"
    aria-hidden="true"
    class="absolute h-11/12 w-11/12"
    name="line-md:sunny-filled-loop-to-moon-filled-loop-transition"
  />
  <Icon
    id="sun"
    aria-hidden="true"
    class="absolute hidden h-11/12 w-11/12"
    name="line-md:moon-filled-to-sunny-filled-loop-transition"
  />
</button>

<script src="../scripts/switch-theme.ts"></script>
