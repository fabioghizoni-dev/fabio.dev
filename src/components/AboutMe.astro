---
import { dict } from "@/i18n";
import GradientBg from "@/ui/GradientBg.astro";
import { removeSpaces } from "@/utils";

const text = dict["pt-BR"].components.aboutMe.text;

const aboutMeClass = removeSpaces(
  `font-cascadia-code relative flex h-fit min-h-screen w-full flex-col items-center justify-center gap-4 p-8 text-white`,
);

const spanClass = removeSpaces(
  `text-gray-default hover:text-gray-default rounded bg-white/80 p-0.5 transition-colors duration-300 ease-in-out 
    hover:bg-transparent dark:hover:text-white/80`,
);
---

<section id="about-me" class={aboutMeClass}>
  <GradientBg class="-z-10 bg-linear-to-tr">
    <div
      class="hidden absolute bg-grid bg-center w-full h-full bg-size-[2.7rem_2.7rem] mask-diagonal-fade"
    >
    </div>
  </GradientBg>
  <div class="flex flex-col justify-center items-center gap-8 max-w-6xl h-full">
    <h2
      id="about"
      class="font-bold text-gray-default dark:text-white/80 text-4xl"
    >
      <span data-i18n="components.aboutMe.about">Sobre</span>
      <span id="me" class={spanClass} data-i18n="components.aboutMe.me">mim</span>
    </h2>
    <p class="bg-gray-default p-4 rounded-md max-w-6xl text-xl text-justify">
      <span data-i18n="components.aboutMe.text">{text}</span>
    </p>
  </div>
</section>
