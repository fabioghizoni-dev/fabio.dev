---
import { dict } from "../i18n";
import GradientBg from "../ui/GradientBg.astro";
import { removeSpaces } from "../utils";

const text = dict["en"].components.aboutMe.text;

const aboutMeClass = removeSpaces(
  `font-cascadia-code relative flex h-fit min-h-screen w-full flex-col items-center justify-center gap-4 p-8 text-white`,
);

const spanClass = removeSpaces(
  `text-gray-default hover:text-gray-default -ml-3 rounded bg-white/80 p-0.5 transition-colors duration-300 ease-in-out 
    hover:bg-transparent dark:hover:text-white/80`,
);
---

<section id="about-me" class={aboutMeClass}>
  <GradientBg class="-z-10 bg-linear-to-tr">
    <div
      class="bg-grid mask-diagonal-fade absolute hidden h-full w-full bg-size-[2.7rem_2.7rem] bg-center"
    >
    </div>
  </GradientBg>
  <div class="max-w-8xl flex h-full flex-col items-center justify-center gap-8">
    <h2
      id="about"
      class="text-gray-default text-4xl font-bold dark:text-white/80"
    >
      About
      <span id="me" class={spanClass}>me</span>
    </h2>
    <p class="bg-gray-default max-w-7xl rounded-md p-4 text-justify text-xl">
      {text}
    </p>
  </div>
</section>
