---
/**
 * Grid + dotted texture used behind the hero and the About section.
 * Purely decorative: hidden from assistive technology and pointer events.
 */
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0">
  <div
    class="absolute inset-0 bg-grid bg-center opacity-25 bg-size-[2.7rem_2.7rem] mix-blend-overlay mask-[radial-gradient(ellipse_at_center,black_44%,transparent_72%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-dots opacity-60 bg-size-[1.35rem_1.35rem] mask-[radial-gradient(ellipse_at_center,black_50%,transparent_78%)]"
  >
  </div>
</div>
