---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ProjectForm from "@/components/admin/ProjectForm.astro";
import { actions } from "astro:actions";
import { getProjectById } from "@/lib/projects";

const { supabase, user } = Astro.locals;
if (!supabase || !user) return Astro.redirect("/admin/login");

const id = Astro.params.id;
if (!id) return Astro.redirect("/admin/projects");

const project = await getProjectById(supabase, id);
if (!project) return Astro.redirect("/admin/projects?missing=1");

const updateResult = Astro.getActionResult(actions.projects.update);
const removeResult = Astro.getActionResult(actions.projects.remove);

if (updateResult?.data?.success) {
  return Astro.redirect("/admin/projects?saved=1");
}

if (removeResult?.data?.success) {
  return Astro.redirect("/admin/projects?removed=1");
}
---

<AdminLayout title={`Editar ${project.title}`} email={user.email}>
  <div class="mx-auto max-w-3xl">
    <div class="mb-6">
      <a
        href="/admin/projects"
        class="font-cascadia-code text-xs text-white/40 transition-colors hover:text-white/80"
      >
        ← voltar para projetos
      </a>
      <h1 class="mt-2 font-space-grotesk text-3xl font-black text-white">
        Editar projeto
      </h1>
      <p class="mt-1 text-sm text-white/45">
        Atualize o conteúdo exibido no card da home.
      </p>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 sm:p-6">
      <ProjectForm
        mode="edit"
        project={project}
        error={updateResult?.error?.message}
      />
    </div>

    <div class="mt-6 rounded-2xl border border-red-400/15 bg-red-400/[0.04] p-5">
      <h2 class="font-space-grotesk text-sm font-bold text-red-200">
        Zona de risco
      </h2>
      <p class="mt-1 text-xs text-red-200/50">
        Excluir remove o projeto do banco e da home imediatamente.
      </p>
      <form method="post" action={actions.projects.remove} class="mt-3">
        <input type="hidden" name="id" value={project.id} />
        <button
          type="submit"
          class="rounded-xl border border-red-400/30 px-4 py-2 text-xs font-semibold text-red-200 transition-colors hover:bg-red-400/10"
          onclick="return confirm('Excluir este projeto?')"
        >
          Excluir projeto
        </button>
      </form>
    </div>
  </div>
</AdminLayout>
