---
import { dict, DEFAULT_LANGUAGE } from "@/i18n";
import Project from "@/ui/projects/Project.astro";
import cn from "@/utils";
import { getProjects } from "@/lib/projects";
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}

const t = dict[DEFAULT_LANGUAGE].components?.projects;
const title = t?.title ?? "Projetos";
const projects = await getProjects();
const { class: className = "" } = Astro.props as Props;
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class={cn(
    "isolate relative flex flex-col justify-center items-center gap-8 bg-light dark:bg-black bg-bottom p-8 w-full min-h-screen overflow-hidden text-gray-default dark:text-white [--light-position:10%]",
    className,
  )}
>
  <h2
    id="projects-title"
    class="inline-flex relative gap-2 font-cascadia-code font-bold text-4xl"
  >
    <span data-i18n="components.projects.title">{title}</span>
    <Icon name="projects" class="size-10" aria-hidden="true" />
  </h2>
  <div class="relative items-stretch gap-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 w-full max-w-6xl">
    {projects.map((project) => (
      <Project project={project} />
    ))}
  </div>
</section>
