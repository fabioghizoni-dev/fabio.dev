---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { Icon } from "astro-icon/components";
import { getCvUrl } from "@/lib/cv";
import { getAdminProjects } from "@/lib/projects";

const { supabase, user } = Astro.locals;
if (!supabase || !user) return Astro.redirect("/admin/login");

const projects = await getAdminProjects(supabase);
const cvUrl = await getCvUrl();

const uploadResult = Astro.getActionResult(actions.cv.upload);
const removeResult = Astro.getActionResult(actions.cv.remove);
const seedResult = Astro.getActionResult(actions.projects.seed);

const messages = [
  uploadResult?.data?.success
    ? { type: "success", text: "Currículo atualizado com sucesso." }
    : null,
  removeResult?.data?.success
    ? { type: "success", text: "Currículo personalizado removido." }
    : null,
  seedResult?.data?.success
    ? {
        type: "success",
        text: `${seedResult.data.imported} projetos importados para o banco.`,
      }
    : null,
  uploadResult?.error?.message
    ? { type: "error", text: uploadResult.error.message }
    : null,
  removeResult?.error?.message
    ? { type: "error", text: removeResult.error.message }
    : null,
  seedResult?.error?.message
    ? { type: "error", text: seedResult.error.message }
    : null,
].filter(Boolean) as { type: "success" | "error"; text: string }[];

const cardClass =
  "rounded-2xl border border-white/15 bg-[#160a2e]/35 p-5 shadow-xl backdrop-blur-xl";
---

<AdminLayout title="Dashboard" email={user.email}>
  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-cascadia-code text-xs uppercase tracking-[0.3em] text-fuchsia-300/70">
          painel
        </p>
        <h1 class="mt-1 font-space-grotesk text-3xl font-black text-white">
          Bem-vindo de volta
        </h1>
        <p class="mt-1 text-sm text-white/45">
          Gerencie o currículo e os projetos exibidos na home.
        </p>
      </div>
      <a
        href="/admin/projects"
        class="inline-flex items-center gap-2 rounded-xl bg-linear-to-r from-fuchsia-500 to-purple-600 px-4 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Gerenciar projetos
        <Icon
          name="material-symbols:arrow-forward-rounded"
          aria-hidden="true"
          class="size-4"
        />
      </a>
    </div>

    {messages.map((message) => (
      <p
        role={message.type === "error" ? "alert" : "status"}
        class:list={[
          "rounded-xl border px-4 py-3 text-sm",
          message.type === "success"
            ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-200"
            : "border-red-400/20 bg-red-400/10 text-red-200",
        ]}
      >
        {message.text}
      </p>
    ))}

    <div class="grid gap-4 sm:grid-cols-3">
      <div class={cardClass}>
        <p class="text-xs uppercase tracking-wider text-white/40">
          Projetos no banco
        </p>
        <p class="mt-2 font-space-grotesk text-3xl font-black text-white">
          {projects.length}
        </p>
      </div>
      <div class={cardClass}>
        <p class="text-xs uppercase tracking-wider text-white/40">Currículo</p>
        <p class="mt-2 text-sm font-semibold text-white">
          {cvUrl === "/cv-fabio.pdf" ? "PDF padrão do projeto" : "PDF enviado"}
        </p>
        <a
          href={cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1 text-xs text-cyan-300 hover:text-cyan-200"
        >
          Abrir currículo
          <Icon
            name="material-symbols:open-in-new-rounded"
            aria-hidden="true"
            class="size-3.5"
          />
        </a>
      </div>
      <div class={cardClass}>
        <p class="text-xs uppercase tracking-wider text-white/40">Status</p>
        <p class="mt-2 inline-flex items-center gap-2 text-sm font-semibold text-emerald-300">
          <span
            class="size-2 rounded-full bg-emerald-400"
            aria-hidden="true"
          ></span>
          Sessão ativa
        </p>
        <p class="mt-2 text-xs text-white/35">{user.email}</p>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <section class={cardClass} aria-labelledby="cv-title">
        <h2
          id="cv-title"
          class="font-space-grotesk text-lg font-bold text-white"
        >
          Currículo
        </h2>
        <p class="mt-1 text-sm text-white/45">
          Envie um PDF de até 8 MB. O botão “Baixar CV” da home passa a apontar
          para o arquivo novo.
        </p>

        <form
          method="post"
          action={actions.cv.upload}
          enctype="multipart/form-data"
          class="mt-4 flex flex-col gap-3"
        >
          <label for="cv-file" class="text-sm font-medium text-white/70">
            Arquivo PDF
          </label>
          <input
            id="cv-file"
            name="file"
            type="file"
            accept="application/pdf,.pdf"
            required
            class="w-full rounded-xl border border-white/10 bg-black/40 px-3 py-2.5 text-sm text-white/70 file:mr-3 file:rounded-lg file:border-0 file:bg-fuchsia-500/20 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-fuchsia-100"
          />
          <div class="flex flex-wrap gap-2">
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-xl bg-linear-to-r from-fuchsia-500 to-purple-600 px-4 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
              <Icon
                name="material-symbols:upload-rounded"
                aria-hidden="true"
                class="size-4"
              />
              Enviar currículo
            </button>
          </div>
        </form>

        {cvUrl !== "/cv-fabio.pdf" && (
          <form
            method="post"
            action={actions.cv.remove}
            class="mt-3 border-t border-white/5 pt-3"
          >
            <button
              type="submit"
              class="text-xs font-medium text-red-300/70 transition-colors hover:text-red-200"
            >
              Remover PDF enviado e voltar ao padrão
            </button>
          </form>
        )}
      </section>

      <section class={cardClass} aria-labelledby="projects-title">
        <h2
          id="projects-title"
          class="font-space-grotesk text-lg font-bold text-white"
        >
          Projetos
        </h2>
        <p class="mt-1 text-sm text-white/45">
          {projects.length > 0
            ? "Os projetos do banco estão sendo exibidos na home."
            : "A home ainda usa a lista estática do código. Importe para começar a editar."}
        </p>

        {projects.length > 0 ? (
          <ul class="mt-4 flex flex-col divide-y divide-white/5">
            {projects.slice(0, 5).map((project) => (
              <li class="flex items-center justify-between gap-3 py-2.5">
                <span class="min-w-0 truncate text-sm text-white/75">
                  {project.title}
                </span>
                <a
                  href={`/admin/projects/${project.id}`}
                  class="shrink-0 text-xs text-cyan-300 hover:text-cyan-200"
                >
                  editar
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <form method="post" action={actions.projects.seed} class="mt-4">
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-xl border border-fuchsia-400/30 bg-fuchsia-400/10 px-4 py-2.5 text-sm font-semibold text-fuchsia-100 transition-colors hover:bg-fuchsia-400/20"
            >
              <Icon
                name="material-symbols:download-rounded"
                aria-hidden="true"
                class="size-4"
              />
              Importar projetos atuais
            </button>
          </form>
        )}
      </section>
    </div>
  </div>
</AdminLayout>
