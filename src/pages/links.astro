---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import Logo from "@/ui/Logo.astro";
import UnderlineButton from "@/ui/UnderlineButton.astro";
import cn from "@/utils";
import p from "@constants/personal";

const links = [
  { href: "/", label: "Home", icon: "mdi:home" },
  { href: p.socials.insta, label: "Instagram", icon: "mdi:instagram" },
  { href: p.socials.linkedin, label: "LinkedIn", icon: "mdi:linkedin" },
  { href: p.socials.github, label: "GitHub", icon: "mdi:github" },
  { href: p.socials.whatsapp, label: "WhatsApp", icon: "mdi:whatsapp" },
  {
    href: p.socials.projects.renext,
    label: "Renext",
    icon: "mdi:web",
  },
  {
    href: p.socials.projects.dailyRoutines,
    label: "Daily Routines",
    icon: "mdi:web",
  },
  {
    href: p.socials.projects.brava,
    label: "BRAVA",
    icon: "mdi:web",
  },
  {
    href: p.socials.projects.jvmPortfolio,
    label: "JVM Portfolio",
    icon: "mdi:web",
  },
];

const containerClass = cn(
  `relative flex flex-col items-center gap-8 bg-white shadow-xl my-12 px-4 py-12 border border-black/5 dark:border-white/10 rounded-3xl w-[min(92vw,42rem)] h-fit overflow-hidden`,
);
---

<Layout title={`Links | ${p.name}`} bodyClass="justify-center">
  <div class={containerClass}>
    <Logo width={128} height={128} class="w-32 h-auto" />

    <h1 class="font-cascadia-code font-bold text-gray-default text-3xl">
      Links úteis
    </h1>

    <ul class="flex flex-col gap-4 w-full max-w-md">
      {links.map((link) => {
        const isExternal = link.href.startsWith("http");
        return (
          <li>
            <UnderlineButton
              href={link.href}
              variant="primary"
              class="justify-center w-full"
              {...(isExternal
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {link.label}
            </UnderlineButton>
          </li>
        );
      })}
    </ul>
  </div>
</Layout>
