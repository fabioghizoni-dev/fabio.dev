---
import { dict } from "@/i18n";
import Technologies from "@/ui/Technologies.astro";
import cn from "@/utils";
import type { Project } from "@constants/projects";
import { Icon } from "astro-icon/components";

interface Props {
  project: Project;
  class?: string;
}

const t = dict["pt-BR"].components.projects;
const { project, class: className = "" } = Astro.props as Props;
const { techs, links } = project;
const projectText = t.items[project.id];
---

<div
  class={cn(
    "group relative flex bg-transparent shadow-purple-950/5 shadow-xl dark:shadow-purple-950/20 rounded-xl h-full overflow-hidden",
    className,
  )}
>
  <div
    class="absolute inset-0 bg-progress-gradient opacity-0 group-hover:opacity-100 rounded-xl transition-opacity animate-spin-gradient duration-300"
  ></div>

  <div
    class="z-10 relative flex flex-col gap-4 bg-gray-default m-0.5 p-5 rounded-[0.65rem] w-full"
  >
    <h3 class="font-space-grotesk font-bold text-white text-xl" data-i18n={`components.projects.items.${project.id}.title`}>{projectText.title}</h3>
    <p class="font-noto-sans-jp text-white/70 text-sm" data-i18n={`components.projects.items.${project.id}.description`}>{projectText.description}</p>
    <Technologies list={techs} />
    <div class="flex gap-3 mt-auto">
      {links.web && (
        <a
          href={links.web}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 font-cascadia-code text-purple-blue hover:text-purple-default text-sm transition-colors"
        >
          <Icon name="mdi:eye" class="size-4" />
          <span data-i18n="components.projects.seeProject">{t.seeProject}</span>
        </a>
      )}
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 font-cascadia-code text-white/70 hover:text-white text-sm transition-colors"
        >
          <Icon name="mdi:github" class="size-4" />
          <span data-i18n="components.projects.viewCode">{t.viewCode}</span>
        </a>
      )}
    </div>
  </div>
</div>
