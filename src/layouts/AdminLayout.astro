---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import p from "@constants/personal";

interface Props {
  title?: string;
  email?: string | null;
}

const { title = "Painel", email } = Astro.props as Props;

const navLink =
  "rounded-lg px-3 py-2 text-sm font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white";
---

<Layout
  title={`${title} | Admin | ${p.name}`}
  modal={false}
  clientRouter={false}
  dataTheme="dark"
  bodyClass="justify-start bg-[#0b0714]"
>
  <div class="min-h-screen w-full px-4 py-6 sm:px-6">
    <header class="mx-auto mb-8 flex max-w-6xl flex-wrap items-center justify-between gap-3 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 backdrop-blur">
      <a href="/admin" class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-xl bg-linear-to-br from-fuchsia-500 to-cyan-400 font-space-grotesk text-sm font-black text-white">
          FG
        </span>
        <span class="font-space-grotesk text-base font-bold text-white">
          Painel
        </span>
        <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 font-cascadia-code text-[10px] font-bold uppercase tracking-wider text-emerald-300">
          admin
        </span>
      </a>

      <nav class="flex flex-wrap items-center gap-1">
        <a href="/admin" class={navLink}>
          <Icon
            name="material-symbols:dashboard-rounded"
            class="mr-1 inline size-4"
            aria-hidden="true"
          />
          Dashboard
        </a>
        <a href="/admin/projects" class={navLink}>
          <Icon
            name="material-symbols:folder-rounded"
            class="mr-1 inline size-4"
            aria-hidden="true"
          />
          Projetos
        </a>
        <a href="/" target="_blank" rel="noopener noreferrer" class={navLink}>
          <Icon
            name="material-symbols:open-in-new-rounded"
            class="mr-1 inline size-4"
            aria-hidden="true"
          />
          Ver site
        </a>
        {email && (
          <span class="hidden px-2 text-xs text-white/35 sm:inline">
            {email}
          </span>
        )}
        <form method="post" action="/admin/logout">
          <button
            type="submit"
            class="rounded-lg border border-white/10 px-3 py-2 text-sm font-medium text-white/60 transition-colors hover:border-red-400/30 hover:bg-red-400/10 hover:text-red-200"
          >
            Sair
          </button>
        </form>
      </nav>
    </header>

    <div class="mx-auto w-full max-w-6xl">
      <slot />
    </div>
  </div>
</Layout>
