---
import { bar, fabio } from "@/scripts/ascii-arts/letters";
import cn, { removeSpaces } from "@/utils";

interface Props {
  class?: string;
}

const nameArray = [
  "F",
  "á",
  "b",
  "i",
  "o\u00A0",
  "G",
  "h",
  "i",
  "z",
  "o",
  "n",
  "i",
  ",",
];

const baseClass = removeSpaces(
  `font-space-grotesk flex flex-col items-center justify-center gap-2 text-left text-3xl font-black md:items-start lg:text-4xl`,
);
const divClass = removeSpaces(
  `min-w-59ch tracking-max relative flex items-center justify-start bg-linear-to-br from-sky-700 via-fuchsia-700 
    to-violet-800 bg-clip-text text-lg leading-none text-transparent contrast-125 dark:via-none dark:from-fuchsia-500 
      dark:to-cyan-500 dark:contrast-100`,
);

const { class: className } = Astro.props as Props;
---

<h1 class={cn(baseClass, className)}>
  <p
    id="hello-world"
    class="inline text-nowrap text-gray-800 dark:text-white/80"
  >
    <span class="animate-char inline-block opacity-0"> I'm </span>
    <br class="md:hidden" />
    {
      nameArray.map((letter, i) => (
        <span
          translate="no"
          style={`animation-delay: ${i * 0.08}s;`}
          class="animate-char inline-block opacity-0"
        >
          {letter}
        </span>
      ))
    }
    <span
      lang="en"
      id="keywords"
      class="animate-blur inline-block transition-all duration-500 ease-in-out"
    ></span>
  </p>
  <div translate="no" class={divClass}>
    <pre id="ascii-art">{fabio}</pre>
    <pre
      id="bar"
      class="animate-opacity hidden transition-opacity duration-500 ease-in-out md:block">{bar.ascii}</pre>
  </div>
</h1>

<script src="../../scripts/ascii-arts/ascii-arts.ts"></script>
