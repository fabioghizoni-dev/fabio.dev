---
import cn from "@/utils";
import { Image } from "astro:assets";

interface LogoProps {
  src?: string;
  class?: string;
  title?: string;
  width?: number | `${number}`;
  height?: number | `${number}`;
}

const {
  width = 80,
  height = 80,
  src = "/logo.svg",
  class: className = "",
  title = "Voltar para página inicial",
}: LogoProps = Astro.props;

const baseClass =
  "animate-show-logo block h-8 cursor-pointer motion-reduce:animate-none";
const finalClass = cn(baseClass, className);
const imageClass = "h-full w-auto object-contain object-left p-0.5";
---

<a
  id="logo"
  href="/"
  title={title}
  aria-label={title}
  data-i18n-attr="title:components.header.returnHome|aria-label:components.header.returnHome"
  class={finalClass}
>
  <Image
    alt=""
    width={width}
    height={height}
    loading="eager"
    decoding="async"
    src={src}
    class={imageClass}
  />
</a>
